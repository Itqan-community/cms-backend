FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libpq-dev \
    libxmlsec1-dev \
    libxml2-dev \
    pkg-config

COPY --from=ghcr.io/astral-sh/uv:0.10.6 /uv /uvx /bin/

COPY pyproject.toml uv.lock ./

ARG DEPENDENCY_GROUP=prod
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$DEPENDENCY_GROUP" = "prod" ]; then \
        uv sync --frozen --no-install-project --no-dev --no-default-groups --extra prod; \
    else \
        uv sync --frozen --no-install-project; \
    fi

# The project itself has no [build-system], so uv never installs it into the
# venv: the builder only needs the dependencies, and the runtime stage copies
# the source directly.

FROM python:3.13-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    UV_NO_CACHE=1

WORKDIR /app

# Install runtime-only system dependencies and create non-root user
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    postgresql-client \
    libpq5 \
    gettext \
    xmlsec1 \
    libxml2 \
    curl \
    ffmpeg \
    && groupadd --system --gid 1001 appgroup \
    && useradd --system --uid 1001 --gid appgroup --create-home appuser

COPY --from=ghcr.io/astral-sh/uv:0.10.6 /uv /uvx /bin/

# Copy the venv and the source as separate layers: the venv only changes with
# pyproject.toml/uv.lock, so its (large) layer stays cached across code changes.
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --chown=appuser:appgroup . /app/

COPY deployment/docker/entrypoint.sh /entrypoint.sh
# Compile the translation catalogs into the image. *.mo is gitignored, and a
# compilemessages run in a one-off deploy container writes them nowhere the
# web container can see, so without this every gettext string served English.
RUN find /app/locale -name '*.po' -execdir sh -c 'for f; do msgfmt --check -o "${f%.po}.mo" "$f" || exit 1; done' _ {} + \
    && chmod +x /entrypoint.sh \
    && mkdir -p /app/logs /app/staticfiles /app/media \
    && chown -R appuser:appgroup /app/logs /app/staticfiles /app/media

USER appuser

EXPOSE 8000

CMD ["/entrypoint.sh"]
