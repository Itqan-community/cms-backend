# Itqan CMS - Environment Variables Template
# Copy this file to .env and update the values for your environment

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DB_NAME=itqan_cms
DB_USER=itqan_user
DB_PASSWORD=itqan_password
DB_HOST=localhost
DB_PORT=5432

# ALLAUTH
ALLAUTH_JWT_PRIVATE_KEY=private_key.pem

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Social Login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Itqan Dependabot updater — GitHub App (#426, disabled by default)
ENABLE_ITQAN_DEPENDABOT=False
# Must stay numeric: settings casts GITHUB_APP_ID with int() at import time,
# even while the updater is disabled. 0 means "not configured".
GITHUB_APP_ID=0
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT_SECONDS=10
GITHUB_TOKEN_CACHE_SKEW_SECONDS=60
GITHUB_WEBHOOK_SECRET=

# Feature flags
ENABLE_ALLAUTH=false
ENABLE_OAUTH2=false

# SAML IDP (djangosaml2idp)
SAML_IDP_ENABLED=False
SAML_IDP_KEY_FILE=saml/idp_private.key
SAML_IDP_CERT_FILE=saml/idp_certificate.crt
# Base URL for SAML endpoints (no trailing slash)
SAML_IDP_BASE_URL=https://cms.itqan.dev
# Path to xmlsec1 binary (brew install xmlsec1 on macOS, apt install xmlsec1 on Debian)
XMLSEC_BINARY=/usr/bin/xmlsec1

# Redis Configuration (used for Django cache + Celery result backend)
REDIS_URL=redis://localhost:6379/1

# Celery Configuration (RabbitMQ as broker, Redis as result backend)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=2

# Flower (Celery monitoring dashboard)
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASS=flower

# Cloudflare R2 Configuration
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Audio usage sync from Cloudflare to Mixpanel
CF_ZONE_ID=
CF_API_TOKEN=
CF_R2_CUSTOM_DOMAIN=
ENABLE_AUDIO_USAGE_SYNC=False
AUDIO_USAGE_SYNC_WINDOW_HOURS=6
# Asset download statistics (optional; defaults shown)
ENABLE_ASSET_DOWNLOAD_SYNC=False
ASSET_DOWNLOAD_SYNC_LAG_MINUTES=15
ASSET_DOWNLOAD_SYNC_REFRESH_HOURS=2
ASSET_DOWNLOAD_SYNC_MAX_SLICES_PER_RUN=24
ASSET_DOWNLOAD_SYNC_STALE_HOURS=6
ASSET_DOWNLOAD_PLAY_WINDOW_MINUTES=5
ASSET_DOWNLOAD_EVENT_RETENTION_DAYS=
# Usage reports (Cloudflare Logpush import + R2 reconciliation); all optional
ENABLE_USAGE_LOGPUSH_IMPORT=False
USAGE_LOGS_BUCKET=itqan-usage-logs
USAGE_LOGS_PREFIX=http/production/
USAGE_LOGS_ACCESS_KEY_ID=
USAGE_LOGS_SECRET_ACCESS_KEY=
USAGE_LOGPUSH_MAX_FILES_PER_RUN=500
ENABLE_USAGE_R2_RECONCILIATION=False
CF_ACCOUNT_ID=
USAGE_ANALYTICS_API_TOKEN=
USAGE_IDENTITY_KEY=
USAGE_EVENT_RETENTION_MONTHS=25
# Open-access gallery downloads via the storage domain (needs the Cloudflare transform rule)
GALLERY_DOWNLOADS_VIA_CDN=False
# Usage reports API: response cache (seconds, 0 = off) and public gallery counts
USAGE_REPORTS_CACHE_SECONDS=600
PUBLIC_USAGE_COUNTS_ENABLED=False

# Gemini free tier (optional) — portal AI translate + human-friendly asset slugs.
# Never link a billing account to the key's project. Empty key: slugs keep the category template with the
# slugified name (e.g. mushaf-warsh), AI translate returns 503.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Sentry Configuration
SENTRY_ENABLED=False
# Use STAGING_SENTRY_DSN or PROD_SENTRY_DSN in CI/CD; locally just set SENTRY_DSN
SENTRY_DSN=
DEFAULT_SERVER_NAME=cms-backend-local
SENTRY_ERRORS_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_DEBUG_BOOL=False
SENTRY_PII_BOOL=True
ENV_NAME=production
SENTRY_PROFILES_SAMPLE_RATE=1
SENTRY_MAX_BREADCRUMBS=50

# Email Configuration
EMAIL_HOST=
EMAIL_PORT=22
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SENDER_NAME=
EMAIL_SENDER_EMAIL=
